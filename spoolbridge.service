[Unit]
Description=spoolbridge - QIDI Box slot to active Spoolman spool
After=network-online.target moonraker.service
Wants=network-online.target moonraker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/spoolbridge/spoolbridge.py
Environment=SPOOLBRIDGE_MOONRAKER=http://127.0.0.1:7125
Environment=SPOOLBRIDGE_POLL=1.0
# Set e.g. "Q2 " to use Spoolman locations ("Q2 slot1") as a fallback.
Environment=SPOOLBRIDGE_LOCATION_PREFIX=
# Book purges and fix per-spool usage after tool changes (0 = off).
Environment=SPOOLBRIDGE_USAGE_CORRECTION=1
Environment=SPOOLBRIDGE_LOAD_OFFSET=67
Restart=always
RestartSec=10

# Runs as a throwaway user without privileges; cannot write anywhere.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M

[Install]
WantedBy=multi-user.target
